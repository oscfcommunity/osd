---
import Heading from "./Heading.astro";
const {
  title = "Open Source Day 2025",
  description = "",
  date = "",
  variant = "default", // "default", "past-events", "venue"
} = Astro.props;
---

<section class="py-12 px-4 bg-white">
  <div class="max-w-6xl mx-auto text-center">
    <Heading title={title} />

    {
      description && (
        <p class={`max-w-3xl mx-auto mt-4 text-gray-600 text-lg`}>
          {description}
        </p>
      )
    }

    {
      variant === "schedule" && date && (
        <div class="flex justify-center mt-8">
          <div class="bg-green-500 text-white px-8 py-3 rounded-full font-semibold">
            {date}
          </div>
        </div>
      )
    }
  </div>
</section>
